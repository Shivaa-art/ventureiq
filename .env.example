# =====================================================================
# VentureIQ — required environment variables
#
# None of these are prefixed VITE_, which is deliberate: Vite only
# exposes VITE_*-prefixed variables to the browser bundle. Everything
# below is read exclusively from src/backend/** (via process.env) and
# must never be renamed to a VITE_ prefix, or it will leak to the
# client bundle.
# =====================================================================

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anon/public key — safe-ish (RLS-scoped) but still only used
# server-side here, to build a per-request client that honors a user's
# JWT (see src/backend/db/client.ts:getSupabaseUserClient).
SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE key — bypasses Row Level Security entirely.
# NEVER expose this to the browser. Used only for background pipeline
# jobs (idea structuring, hypothesis generation, evidence collection,
# scoring) that must write across the schema as the system, not as a
# specific authenticated user.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# AI provider (src/backend/ai/client.ts + src/backend/ai/providers/)
#
# AI_PROVIDER selects which provider every AI-facing service uses —
# ideaParser, assumptionExtractor, hypothesisGenerator,
# evidenceRequirementGenerator, evidenceClassifier, and the research
# planner all go through the same abstraction and don't need to know
# which one is active. Only ONE of the two key blocks below is
# required, matching whichever provider you select.
#
#   gemini    (default — free-tier friendly for local development)
#   anthropic (also powers the external research engine's real web
#              search — Gemini's free tier has no equivalent in this
#              implementation, so research falls back to failing
#              honestly rather than fabricating sources when
#              AI_PROVIDER=gemini; see docs/ai-providers.md)
# ---------------------------------------------------------------------
AI_PROVIDER=gemini

# Google Gemini API key (https://aistudio.google.com/apikey). Required
# when AI_PROVIDER=gemini (the default). Never exposed to the browser.
GEMINI_API_KEY=

# Gemini model to use. Defaults to "gemini-2.5-flash" (free-tier) if
# unset — set this explicitly if you want a different model, e.g. the
# smaller/cheaper "gemini-2.5-flash-lite" if you hit free-tier rate
# limits. Do not hardcode a paid-only model here.
GEMINI_MODEL=

# Anthropic API key. Required only when AI_PROVIDER=anthropic. Also
# required to use the external research engine's real web search (see
# above) regardless of which provider handles the rest of the
# pipeline — the research engine's search step specifically needs
# Anthropic's native web_search tool.
ANTHROPIC_API_KEY=

# Public site URL (no trailing slash), e.g. https://ventureiq.app or
# http://localhost:3000 in dev. Used to build the password-reset email
# link (src/backend/auth/session.ts). Safe to be public.
SITE_URL=
